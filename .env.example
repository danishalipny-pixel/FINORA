# FINORA - Environment Configuration
APP_NAME="FINORA – Personal Finance Intelligence"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finora_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Financial Defaults
APP_CURRENCY=PKR
APP_CURRENCY_SYMBOL=Rs.
APP_DATE_FORMAT="d M Y"

# Security & Session
SESSION_LIFETIME=7200
SESSION_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900

# Mail Configuration (Optional - Core functions without SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@finora.test
MAIL_FROM_NAME="FINORA Finance"
