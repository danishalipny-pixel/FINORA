{
    "name": "danishalipny-pixel/finora",
    "description": "FINORA – Premium Personal Finance Intelligence Management System",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/danishalipny-pixel/FINORA",
    "authors": [
        {
            "name": "Danish Ali",
            "homepage": "https://github.com/danishalipny-pixel",
            "role": "Lead Software Engineer & Architect"
        }
    ],
    "keywords": [
        "finora",
        "personal-finance",
        "fintech",
        "wealth-management",
        "budget-tracker",
        "expense-manager",
        "core-php",
        "mysql8",
        "portfolio-project"
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php tests/run_tests.php",
        "migrate": "php database/migrations/migrate.php",
        "seed": "php database/seeders/DatabaseSeeder.php"
    }
}
